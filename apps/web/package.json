{
  "name": "@jonny-boi/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The jonny-boi React/Vite PWA shell (deck builder, card browser, lab, match viewer).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "icons": "node scripts/generate-icons.mjs",
    "cards:index": "node scripts/build-card-index.mjs",
    "cards:glossary": "node scripts/check-glossary-coverage.mjs",
    "preview": "vite preview",
    "verify:reporter": "node scripts/verify-bug-reporter.mjs"
  },
  "dependencies": {
    "@jonny-boi/ai": "*",
    "@jonny-boi/cards": "*",
    "@jonny-boi/core": "*",
    "@jonny-boi/data-tools": "*",
    "@jonny-boi/protocol": "*",
    "@jonny-boi/sim": "*",
    "html-to-image": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rrweb": "^2.1.1",
    "rrweb-player": "^2.1.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jpeg-js": "^0.4.4",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
