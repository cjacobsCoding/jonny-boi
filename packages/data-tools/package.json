{
  "name": "@jonny-boi/data-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scryfall fetch/cache tooling that produces a normalized card index.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pure": {
      "types": "./dist/pure.d.ts",
      "default": "./dist/pure.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "fetch": "npm run build && node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2"
  }
}
