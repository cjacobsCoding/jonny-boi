{
  "name": "jonny-boi",
  "version": "0.0.0",
  "private": true,
  "description": "An MTG deck-tuning lab: AI-piloted gauntlet sims with statistically-grounded single-card A/B testing.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @jonny-boi/core -w @jonny-boi/protocol -w @jonny-boi/data-tools -w @jonny-boi/cards -w @jonny-boi/ai -w @jonny-boi/sim -w @jonny-boi/web -w @jonny-boi/server --if-present",
    "test": "vitest run",
    "dev": "npm run dev --workspace @jonny-boi/web",
    "server": "tsx apps/server/src/main.ts",
    "build:server": "npm run build -w @jonny-boi/core -w @jonny-boi/protocol -w @jonny-boi/data-tools -w @jonny-boi/cards -w @jonny-boi/ai -w @jonny-boi/sim -w @jonny-boi/server --if-present",
    "bundle:server": "esbuild apps/server/src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-bundle/server.cjs --external:bufferutil --external:utf-8-validate",
    "host:online": "powershell -ExecutionPolicy Bypass -File scripts/host-online.ps1",
    "sim": "npm run sim --workspace @jonny-boi/sim --",
    "verify": "npm run lint && node apps/web/scripts/build-card-index.mjs --check && npm run build && vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.2",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
